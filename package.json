{
  "name": "st-thoughts",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "generate-assets": "node scripts/generate-assets.mjs",
    "build:ios": "npx eas build --platform ios --profile production",
    "build:android": "npx eas build --platform android --profile production",
    "build:all": "npx eas build --platform all --profile production",
    "submit:ios": "npx eas submit --platform ios",
    "submit:android": "npx eas submit --platform android",
    "preview:ios": "npx eas build --platform ios --profile preview",
    "preview:android": "npx eas build --platform android --profile preview"
  },
  "dependencies": {
    "@expo-google-fonts/bebas-neue": "^0.2.3",
    "@expo-google-fonts/dm-mono": "^0.2.3",
    "@expo-google-fonts/dm-sans": "^0.2.3",
    "@expo-google-fonts/playfair-display": "^0.2.3",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "@supabase/supabase-js": "^2.43.4",
    "date-fns": "^3.6.0",
    "expo": "~51.0.0",
    "expo-build-properties": "~0.12.0",
    "expo-constants": "~16.0.0",
    "expo-device": "~6.0.0",
    "expo-font": "~12.0.9",
    "expo-notifications": "~0.28.0",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "~3.31.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.79",
    "eas-cli": "^20.0.0",
    "jimp": "^1.6.1",
    "typescript": "^5.3.0"
  }
}
